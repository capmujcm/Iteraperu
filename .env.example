# Variables de Entorno para Railway / Producción
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://usuario:password@host:port/database

# --- SEGURIDAD -------------------------------------------------------------
# Token de staff/organizador. OBLIGATORIO en producción: protege la lista de
# asistentes (DNI/email/celular), la analítica, el check-in y el re-seed.
# Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Orígenes externos autorizados para CORS, separados por comas.
# Vacío = solo mismo origen (recomendado).
# ALLOWED_ORIGINS=https://iteraperu.pe,https://www.iteraperu.pe

# Validar el certificado TLS de PostgreSQL. Actívalo si tu proveedor
# expone una CA pública válida.
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- EVENTO ----------------------------------------------------------------
# Identidad del evento activo. Se crea/actualiza en la tabla `eventos` al
# arrancar. El slug es la clave: cambiarlo crea un evento distinto.
EVENT_SLUG=country-fest
EVENT_NAME=Country Fest 2026
# EVENT_DESC=
# EVENT_PLACE=
# EVENT_AFORO=500

# --- DATOS DE DEMOSTRACION -------------------------------------------------
# true siembra asistentes ficticios (codigos DEMO-*). DEJAR APAGADO en una
# prueba real: contamina el aforo, la analitica y la lista de asistentes.
SEED_DEMO=false

# Nivel de log del servidor (fatal, error, warn, info, debug, trace).
# LOG_LEVEL=info
