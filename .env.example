# Variables de Entorno para Railway / Producción
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://usuario:password@host:port/database

# --- SEGURIDAD -------------------------------------------------------------
# Token de staff/organizador. OBLIGATORIO en producción: protege la lista de
# asistentes (DNI/email/celular), la analítica, el check-in y el re-seed.
# Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Orígenes externos autorizados para CORS, separados por comas.
# Vacío = solo mismo origen (recomendado).
# ALLOWED_ORIGINS=https://iteraperu.pe,https://www.iteraperu.pe

# Validar el certificado TLS de PostgreSQL. Actívalo si tu proveedor
# expone una CA pública válida.
# DB_SSL_REJECT_UNAUTHORIZED=true
